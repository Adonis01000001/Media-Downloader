# Use an HTTPS address you control and register the callback URI exactly in the Meta app.
PORT=8787
HOST=127.0.0.1
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://oauth.example.com/v1/instagram/oauth/callback
INSTAGRAM_API_VERSION=v26.0

# X OAuth 2.0 credentials stay on this backend; register the exact HTTPS callback URI.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://oauth.example.com/v1/x/oauth/callback
